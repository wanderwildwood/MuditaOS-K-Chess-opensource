    <!-- About, opened by the i at the top right of the first screen. %1$s is the version, e.g. "1.3.10" -->
    <string name="chess_about_title" translatable="false">Chess+ %1$s</string>
    <string name="chess_about_what" tools:ignore="MissingTranslation">Mudita\'s own Chess for the Kompakt, with a second player added: two people at one board, passing the phone between moves.</string>
    <string name="chess_about_licence" translatable="false">GNU General Public License v3</string>
    <string name="chess_about_engine" translatable="false">Fairy-Stockfish 14 — © the Stockfish developers and Fabian Fichter, same license</string>
    <string name="chess_about_feed_the_llamas" tools:ignore="MissingTranslation">Feed the llamas</string>
    <string name="chess_about_no_browser" tools:ignore="MissingTranslation">There is no web browser on this phone to open that with.</string>
    <string name="chess_about_no_browser_address" tools:ignore="MissingTranslation">No browser is installed. The address is %1$s.</string>
    <string name="chess_about_close" tools:ignore="MissingTranslation">Close</string>
    <string name="chess_about_back" tools:ignore="MissingTranslation">Back</string>
    <string name="chess_about_privacy_title" tools:ignore="MissingTranslation">Privacy</string>
    <string name="chess_about_privacy" tools:ignore="MissingTranslation">Everything you do in this app stays on this phone. It has no internet access, so nothing is sent anywhere, and nothing is collected about you. The game in progress, your options and your statistics are kept in the app\'s own storage and go when you uninstall it. It asks for no permissions. There are no ads, no analytics and no tracking.</string>
    <string name="chess_about_terms_title" tools:ignore="MissingTranslation">Terms</string>
    <string name="chess_about_terms" tools:ignore="MissingTranslation">This app is free software under the GNU General Public License v3. It comes with no warranty: use it at your own risk.</string>
    <string name="chess_about_licences_button" tools:ignore="MissingTranslation">Licenses</string>
    <string name="chess_licences_title" tools:ignore="MissingTranslation">Licenses</string>
    <string name="chess_licences_app" tools:ignore="MissingTranslation">Chess+ is free software under the GNU General Public License, version 3 only (GPL-3.0-only), copyright wander wildwood for what is written here. The work it is built on keeps its own license and its authors keep their copyright, each on its own page.</string>
    <string name="chess_licences_source_title" tools:ignore="MissingTranslation">Source code</string>
