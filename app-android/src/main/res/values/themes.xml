<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
      No splash screen.

      Android 12 shows one whether or not an app asks, and the only lever is what it
      draws, so it draws nothing: a transparent icon on white, indistinguishable from
      the board's own background. A logo that flashes up and vanishes costs a
      full-panel e-ink refresh before the game has done anything at all.
    -->
    <style name="Theme.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@android:color/white</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_nothing</item>
        <item name="windowSplashScreenAnimationDuration">0</item>
        <item name="postSplashScreenTheme">@style/Theme.App</item>
    </style>

    <style name="Theme.App" parent="Theme.AppCompat.DayNight.NoActionBar" />

</resources>
